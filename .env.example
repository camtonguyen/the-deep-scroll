# Public address of the deployed page, no trailing slash. Used for the og:image URL LinkedIn needs and the certificate link in the email.
# Required in production. Leave empty in dev: the request address is used.
SITE_URL=

# Welcome email (Brevo, free tier: 9,000 a month, 300 a day). Both empty: the email is written to out/ instead of sent.
BREVO_API_KEY=
# One sender address you have verified in Brevo.
MAIL_FROM=

# Secret that signs the certificate link in the welcome email (any long random string, e.g. `openssl rand -hex 32`).
# Required in production (the link is refused without it). Empty in dev: a fixed dev secret is used.
CERTIFICATE_SECRET=
