{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:api",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "assets/fonts/**"
    }
  }
}
