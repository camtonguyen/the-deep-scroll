{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "mkdir -p public && touch public/.keep && pnpm build:api",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    }
  ],
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/*.ts": {
      "includeFiles": "{assets/fonts/**,node_modules/.pnpm/{pdfkit@*/node_modules/pdfkit,harfbuzzjs@*/node_modules/harfbuzzjs}/**}"
    }
  }
}
