{
  "name": "the-deep-scroll",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "render": "tsx scripts/render.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && prettier --check . && pnpm render",
    "format": "prettier --write .",
    "build:api": "esbuild functions/*.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outdir=api"
  },
  "dependencies": {
    "@hyper-elements/react": "^0.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.21"
  },
  "description": "The Deep Scroll: scroll from the sea surface to 10,935 m. One React design, four outputs (page, email, PDF, PNG), built with Hyper Elements.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.21.0"
}
